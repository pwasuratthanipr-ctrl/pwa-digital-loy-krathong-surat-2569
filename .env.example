# ====================================================================
# PWA Digital Loy Krathong 2026 - Environment Variables Configuration
# การประปาส่วนภูมิภาคสาขาสุราษฎร์ธานี (ชั้นพิเศษ)
# กิจกรรม: “ลอยกระทงออนไลน์ ส่งความสุข ไม่เพิ่มขยะ ๒๕๖๙”
# ====================================================================

# Port for Express Full-stack Server (Default: 3000)
PORT=3000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Base URL of the deployed application
APP_URL="https://your-domain.pwa.co.th"

# Optional: PostgreSQL / Supabase Database Connection String
# If left unset, the system runs safely in embedded secure store mode
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=""

# Secret key for admin session authentication (Minimum 32 random characters in production)
ADMIN_SESSION_SECRET="pwa_surat_thani_loy_krathong_2569_secret_key"

# Google Apps Script Web App API URL for Google Sheets Database (Shared across all devices)
# Example: https://script.google.com/macros/s/AKfycb.../exec
VITE_GOOGLE_SCRIPT_API_URL=""

# Gemini API Key (if AI smart wish generation or assistance is enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
